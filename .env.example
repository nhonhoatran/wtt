# Copy to .env for local dev. Placeholders only — never commit real values.
# Staging/production values are set in Dokploy, one project per environment.

# --- Runtime ---
NODE_ENV=development
APP_ENV=development
TZ=UTC
LOG_LEVEL=info

# --- Local dev dependencies (docker-compose.dev.yml) ---
DEV_POSTGRES_USER=kamito
DEV_POSTGRES_PASSWORD=change-me-local
DEV_POSTGRES_DB=kamito_tt_dev
DEV_POSTGRES_PORT=5433
DEV_REDIS_PORT=6380
DEV_S3_PORT=9010
DEV_S3_CONSOLE_PORT=9011
DEV_S3_ACCESS_KEY=kamito-dev
DEV_S3_SECRET_KEY=change-me-local-s3
DEV_S3_BUCKET=kamito-tt-dev

# --- Database ---
DATABASE_URL=postgresql://kamito:change-me-local@localhost:5433/kamito_tt_dev
# Migrate role; leave equal to DATABASE_URL when no separate role exists.
DATABASE_MIGRATE_URL=postgresql://kamito:change-me-local@localhost:5433/kamito_tt_dev
# Must equal "host:port/database" of the migrate URL or the migrate job refuses to run.
MIGRATE_CONFIRM_TARGET=localhost:5433/kamito_tt_dev
# Only needed against a remote dev DB where the role lacks CREATEDB (leave unset locally).
# SHADOW_DATABASE_URL=postgresql://user:password@host:5432/kamito_tt_shadow

# --- Redis / queue ---
REDIS_URL=redis://localhost:6380
QUEUE_PREFIX=kamito-tt:development
REDIS_EVICTION_CHECK_OVERRIDE=

# --- S3-compatible storage ---
S3_ENDPOINT=http://localhost:9010
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=kamito-dev
S3_SECRET_ACCESS_KEY=change-me-local-s3
S3_BUCKET=kamito-tt-dev
S3_FORCE_PATH_STYLE=true
# Upload design (a) only.
S3_PRESIGN_ENDPOINT=
S3_PUBLIC_BASE_URL=

# --- Secrets (>= 32 random bytes each, distinct per purpose and environment) ---
AUTH_SECRET=replace-with-32-plus-random-bytes-auth
REVALIDATE_SECRET=replace-with-32-plus-random-bytes-revalidate
SSR_INTERNAL_SECRET=replace-with-32-plus-random-bytes-ssr
IP_HASH_SALT=replace-with-32-plus-random-bytes-salt

# --- Service URLs ---
API_PORT=3000
API_INTERNAL_URL=http://localhost:3000
CLIENT_INTERNAL_URL=http://localhost:3001
PUBLIC_SITE_URL=http://localhost:3001
ADMIN_PUBLIC_URL=http://localhost:5173
API_BASE_PATH=/api/v1
TRUST_PROXY_HOPS=0
WORKER_HEALTH_PORT=3010

# --- Client cache TTL (seconds) ---
PUBLIC_REVALIDATE_SECONDS=300
MATCHDAY_REVALIDATE_SECONDS=30

# --- Upload / import limits ---
UPLOAD_MAX_IMAGE_BYTES=5242880
UPLOAD_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
MEDIA_IMAGE_VARIANT_WIDTHS=320,640,1280
IMPORT_MAX_FILE_BYTES=5242880
IMPORT_MAX_UNZIPPED_BYTES=52428800
IMPORT_MAX_ROWS=5000
IMPORT_RETENTION_DAYS=30

# --- API pagination (technical knobs) ---
PAGINATION_MAX_PAGE_SIZE=100
QUERY_MAX_LENGTH=100
