{
  "name": "@kamito/client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test:e2e": "playwright test",
    "test:print": "vitest run --config vitest.bracket-print.config.ts",
    "audit:lighthouse": "node tests/performance/lighthouse-audit.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@kamito/shared": "workspace:*",
    "@kamito/ui-tokens": "workspace:*",
    "ioredis": "6.0.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize-html": "2.18.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@kamito/config": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "eslint": "10.13.0",
    "lighthouse": "13.6.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
