{
  "name": "@kamito/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --env-file-if-exists=../../.env --watch --import @swc-node/register/esm-register src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@kamito/db": "workspace:*",
    "@kamito/shared": "workspace:*",
    "bullmq": "6.5.1",
    "exceljs": "4.4.0",
    "fflate": "0.8.3",
    "ioredis": "6.0.0",
    "pino": "10.4.0",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@kamito/config": "workspace:*",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.16.20",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
