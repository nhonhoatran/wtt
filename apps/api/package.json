{
  "name": "@kamito/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --env-file-if-exists=../../.env --watch --import @swc-node/register/esm-register src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "create-admin": "node --env-file-if-exists=../../.env --import @swc-node/register/esm-register src/cli/create-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1159.0",
    "@bull-board/api": "9.10.5",
    "@bull-board/express": "9.10.5",
    "@kamito/competition-engine": "workspace:*",
    "@kamito/db": "workspace:*",
    "@kamito/ranking-engine": "workspace:*",
    "@kamito/shared": "workspace:*",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "better-auth": "1.7.21",
    "bullmq": "6.5.1",
    "exceljs": "4.4.0",
    "express": "5.3.0",
    "fflate": "0.8.3",
    "ioredis": "6.0.0",
    "nestjs-pino": "5.3.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sanitize-html": "2.18.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@kamito/config": "workspace:*",
    "@nestjs/testing": "12.3.2",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.16.20",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/sanitize-html": "2.16.2",
    "@types/supertest": "7.2.1",
    "eslint": "10.13.0",
    "sharp": "0.35.5",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  }
}
