    "ioredis": "6.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@kamito/config": "workspace:*",
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
