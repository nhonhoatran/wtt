{
  "name": "@kamito/ui-tokens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./antd-theme": {
      "types": "./dist/antd-theme.d.ts",
      "default": "./dist/antd-theme.js"
    },
    "./tokens.css": "./dist/tokens.css"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/write-tokens-css.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "antd": "^5.29.0"
  },
  "peerDependenciesMeta": {
    "antd": { "optional": true }
  },
  "devDependencies": {
    "@kamito/config": "workspace:*",
    "@types/node": "24.19.2",
    "antd": "5.29.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
