enum PublishStatus {
  DRAFT
  PUBLISHED
}

// Lifecycle (upcoming / ongoing / completed) is derived from the dates + isCancelled, never stored.
model Event {
  id            String                @id @default(uuid())
  slug          String                @unique
  name          String
  nameEn        String?
  shortName     String?
  eventTypeId   String
  eventType     EventType             @relation(fields: [eventTypeId], references: [id], onDelete: Restrict)
  venueId       String?
  venue         Venue?                @relation(fields: [venueId], references: [id], onDelete: Restrict)
  city          String?
  startDate     DateTime              @db.Date
  endDate       DateTime              @db.Date
  timezone      String
  publishStatus PublishStatus         @default(DRAFT)
  publishedAt   DateTime?
  isCancelled   Boolean               @default(false)
  isFeatured    Boolean               @default(false)
  ticketUrl     String?
  showTicket    Boolean               @default(false)
  presentedBy   String?
  bannerMediaId String?
  bannerMedia   MediaAsset?           @relation("EventBanner", fields: [bannerMediaId], references: [id], onDelete: SetNull)
  summary       String?
  summaryEn     String?
  // Sanitized rich HTML (sanitized again on render).
  infoBody      String?
  infoBodyEn    String?
  showInfoTab   Boolean               @default(true)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  subEvents     SubEvent[]
  importJobs    ImportJob[]
  matches       Match[]
  sessions      EventSession[]
  matchCounter  EventMatchCounter?
  rankingPoints RankingPointsEarned[]
  articles      ArticleEvent[]
  videos        Video[]
  sponsors      Sponsor[]

  @@index([startDate])
  @@index([eventTypeId])
  @@index([venueId])
}

enum SubEventFormat {
  KNOCKOUT
  GROUP_KNOCKOUT
}

model SubEvent {
  id                 String                @id @default(uuid())
  eventId            String
  event              Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  disciplineId       String
  discipline         Discipline            @relation(fields: [disciplineId], references: [id], onDelete: Restrict)
  categoryId         String?
  category           Category?             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  code               String
  name               String?
  nameEn             String?
  format             SubEventFormat
  hasQualifying      Boolean               @default(false)
  matchFormatId      String
  matchFormat        MatchFormat           @relation(fields: [matchFormatId], references: [id], onDelete: Restrict)
  groupScoringRuleId String?
  groupScoringRule   GroupScoringRule?     @relation(fields: [groupScoringRuleId], references: [id], onDelete: Restrict)
  rankingListId      String?
  rankingList        RankingList?          @relation(fields: [rankingListId], references: [id], onDelete: SetNull)
  // Set in the same transaction as any change that affects ranking points; cleared by the recompute job (compare-and-clear).
  rankingDirtyAt     DateTime?
  rankingPoints      RankingPointsEarned[]
  entries            Entry[]
  draws              Draw[]
  matches            Match[]
  maxEntries         Int?
  order              Int                   @default(0)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@unique([eventId, code])
  @@index([disciplineId])
  @@index([categoryId])
  @@index([matchFormatId])
  @@index([groupScoringRuleId])
  @@index([rankingListId])
}
