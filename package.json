{
  "name": "kamito-tt",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --env-mode=loose && node --test \"scripts/**/*.test.mjs\"",
    "test:admin-full-flow": "node scripts/admin-full-flow.mjs",
    "test:admin-browser": "node --test --test-concurrency=1 \"apps/admin/test/**/*.browser.mjs\"",
    "db:print-target": "node scripts/print-db-target.mjs"
  },
  "devDependencies": {
    "turbo": "2.11.10",
    "typescript": "6.0.3"
  }
}
